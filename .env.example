# ===========================================================
# Frontend
# ===========================================================

# Backend API base URLs (set per environment)
VITE_API_BASE=http://localhost:8000
VITE_WS_BASE=ws://localhost:8000

# Set to true to enable the mock demo mode (MockPages + demoAgent)
# This is tree-shaken from production builds when false.
VITE_DEMO_MODE=false

# ===========================================================
# Backend
# ===========================================================

# Database — SQLite for local dev, Postgres for production
DATABASE_URL=sqlite:///./pilot.db
# DATABASE_URL=postgresql://pilot:pilot@localhost:5432/pilot

# LLM providers (at least one required for the agent to work)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Jev Decider (optional — falls back to LLMDecider if not set)
# Get from https://typesafe.ai
TYPESAFE_API_KEY=
# Which decider to use: "llm" (default) or "jev"
DECIDER=llm

# Secret vault (optional) — AES-256-GCM encryption key (32 bytes hex)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_ENCRYPTION_KEY=

# Session / auth
SESSION_SECRET=change-me-in-production-use-a-random-64-char-string
CSRF_SECRET=change-me-too

# Google OAuth (disabled by default)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser / screencast settings
BROWSER_MODE=local           # local | remote
SCREENCAST_FPS=10
SCREENCAST_QUALITY=75        # JPEG quality 1-100

# Agent limits
MAX_CONCURRENT_RUNS=2        # per user
APPROVAL_TIMEOUT_SECONDS=300 # 5 minutes
MAX_STEPS_PER_RUN=60
MAX_RUN_SECONDS=600          # 10 minutes

# Server
PORT=8000
CORS_ORIGINS=http://localhost:3000

# KILL_SWITCH=true  # Uncomment to disable all new runs globally
